# Copy to .env next to docker-compose.yml and fill in your domain.
#   cp .env.example .env
# Compose reads this automatically. Do NOT commit the real .env.

# Public URL the browser uses. Must match exactly (scheme + host, no trailing slash)
# or the backend's CORS check rejects every API call.
ALLOWED_ORIGIN=https://erp.yourdomain.com
FRONTEND_URL=https://erp.yourdomain.com

# Hostnames the Vite dev server will accept in the Host header.
# nginx forwards the public domain, so it must be listed here.
# Comma-separated. Include the bare domain, no scheme.
VITE_ALLOWED_HOSTS=erp.yourdomain.com

# Host ports (loopback-bound in docker-compose.yml):
#   127.0.0.1:8090 -> frontend
#   127.0.0.1:8091 -> backend (direct access for debugging only)
