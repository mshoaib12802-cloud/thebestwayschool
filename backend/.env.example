# Copy to backend/.env on the server and fill in real values:
#   cp backend/.env.example backend/.env
# docker-compose.yml references this path via env_file, so compose will refuse
# to start if it's missing. Never commit the filled-in .env.

NODE_ENV=production
PORT=5000

# Overridden by docker-compose (points at the mongo service). Left here so the
# backend can also be run outside Docker.
MONGO_URI=mongodb://mongo:27017/institute_erp

# Generate a fresh one per environment — do NOT reuse the local dev value:
#   openssl rand -hex 48
JWT_SECRET=

# Seed/bootstrap admin credentials
ADMIN_SEED_PASSWORD=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Gmail SMTP — use an App Password, not the account password.
# Google Account > Security > 2-Step Verification > App passwords
EMAIL_USER=
EMAIL_PASS=

# Gemini AI key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# NOTE: FRONTEND_URL and ALLOWED_ORIGIN are also set here for non-Docker runs,
# but docker-compose.yml's `environment:` block takes precedence over env_file.
# When running under Docker, set them in the ROOT .env instead.
FRONTEND_URL=https://erp.yourdomain.com
ALLOWED_ORIGIN=https://erp.yourdomain.com

# Set to 1 once this deployment holds real data. The seed re-creates demo
# teachers/students and resets the admin password on every container start.
SKIP_SEED=0

# Emergency lockout recovery only. Set to 1 for ONE restart to force the admin
# email/password back to the values above, then set it back to 0.
ADMIN_FORCE_SYNC=0
